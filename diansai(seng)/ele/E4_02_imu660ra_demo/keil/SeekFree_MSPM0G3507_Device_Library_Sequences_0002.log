[02:06:09.324]        // =>  TRUE
[02:06:09.324]      <control if="isSWJ" while="" timeout="0" info="">
[02:06:09.324]        // if-block "isSWJ"
[02:06:09.324]          // =>  TRUE
[02:06:09.324]        <control if="hasDormant" while="" timeout="0" info="">
[02:06:09.324]          // if-block "hasDormant"
[02:06:09.325]            // =>  FALSE
[02:06:09.325]          // skip if-block "hasDormant"
[02:06:09.325]        </control>
[02:06:09.325]        <control if="!hasDormant" while="" timeout="0" info="">
[02:06:09.325]          // if-block "!hasDormant"
[02:06:09.325]            // =>  TRUE
[02:06:09.325]          <block atomic="false" info="">
[02:06:09.325]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[02:06:09.326]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:06:09.326]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[02:06:09.328]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[02:06:09.328]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[02:06:09.331]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:06:09.331]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[02:06:09.332]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[02:06:09.333]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[02:06:09.335]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:06:09.335]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[02:06:09.337]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[02:06:09.337]          </block>
[02:06:09.337]          // end if-block "!hasDormant"
[02:06:09.337]        </control>
[02:06:09.337]        // end if-block "isSWJ"
[02:06:09.337]      </control>
