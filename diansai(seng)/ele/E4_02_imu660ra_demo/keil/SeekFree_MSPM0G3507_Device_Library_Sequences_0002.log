[01:33:55.973]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[01:33:55.973]    <block atomic="false" info="">
[01:33:55.973]      __var SW_DP_ABORT       = 0x0;
[01:33:55.973]        // -> [SW_DP_ABORT <= 0x00000000]
