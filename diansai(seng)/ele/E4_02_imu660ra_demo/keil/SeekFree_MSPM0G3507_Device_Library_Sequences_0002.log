[01:33:55.950]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[01:33:55.950]    <block atomic="false" info="">
[01:33:55.950]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[01:33:55.950]        // -> [isSWJ <= 0x00000001]
[01:33:55.950]      __var hasDormant = __protocol & 0x00020000;
[01:33:55.950]        // -> [hasDormant <= 0x00000000]
[01:33:55.950]      __var protType   = __protocol & 0x0000FFFF;
[01:33:55.950]        // -> [protType <= 0x00000002]
[01:33:55.950]    </block>
[01:33:55.950]    <control if="protType == 1" while="" timeout="0" info="">
[01:33:55.950]      // if-block "protType == 1"
[01:33:55.950]        // =>  FALSE
[01:33:55.950]      // skip if-block "protType == 1"
[01:33:55.950]    </control>
[01:33:55.951]    <control if="protType == 2" while="" timeout="0" info="">
[01:33:55.951]      // if-block "protType == 2"
[01:33:55.951]        // =>  TRUE
[01:33:55.951]      <control if="isSWJ" while="" timeout="0" info="">
[01:33:55.951]        // if-block "isSWJ"
[01:33:55.951]          // =>  TRUE
[01:33:55.951]        <control if="hasDormant" while="" timeout="0" info="">
[01:33:55.951]          // if-block "hasDormant"
[01:33:55.951]            // =>  FALSE
[01:33:55.952]          // skip if-block "hasDormant"
[01:33:55.952]        </control>
[01:33:55.952]        <control if="!hasDormant" while="" timeout="0" info="">
[01:33:55.952]          // if-block "!hasDormant"
[01:33:55.952]            // =>  TRUE
[01:33:55.952]          <block atomic="false" info="">
[01:33:55.952]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[01:33:55.954]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[01:33:55.954]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[01:33:55.957]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[01:33:55.957]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[01:33:55.958]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[01:33:55.959]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[01:33:55.960]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[01:33:55.960]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[01:33:55.963]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[01:33:55.963]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[01:33:55.965]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[01:33:55.965]          </block>
[01:33:55.965]          // end if-block "!hasDormant"
[01:33:55.965]        </control>
[01:33:55.965]        // end if-block "isSWJ"
[01:33:55.965]      </control>
[01:33:55.965]      <control if="!isSWJ" while="" timeout="0" info="">
[01:33:55.965]        // if-block "!isSWJ"
[01:33:55.965]          // =>  FALSE
[01:33:55.965]        // skip if-block "!isSWJ"
[01:33:55.965]      </control>
[01:33:55.965]      <block atomic="false" info="">
[01:33:55.966]        ReadDP(0x0);
[01:33:55.968]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[01:33:55.968]      </block>
[01:33:55.968]      // end if-block "protType == 2"
[01:33:55.968]    </control>
[01:33:55.968]  </sequence>
