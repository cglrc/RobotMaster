[01:19:20.883]      version = deviceID >> 28;
[01:19:20.883]        // -> [version <= 0x00000002]
[01:19:20.883]      partNum = (deviceID & 0x0FFFF000) >> 12;
[01:19:20.883]        // -> [partNum <= 0x0000BB88]
[01:19:20.883]      manuf = (deviceID & 0x00000FFE) >> 1;
[01:19:20.883]        // -> [manuf <= 0x00000017]
[01:19:20.883]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[01:19:20.883]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[01:19:20.883]      isProduction = (version > 0);
[01:19:20.883]        // -> [isProduction <= 0x00000001]
[01:19:20.883]    </block>
[01:19:20.883]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[01:19:20.884]      // if-block "!isMSPM0G1X0X_G3X0X"
[01:19:20.884]        // =>  FALSE
[01:19:20.884]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[01:19:20.884]    </control>
[01:19:20.884]    <control if="continueId == 4" while="" timeout="0" info="">
[01:19:20.884]      // if-block "continueId == 4"
[01:19:20.884]        // =>  FALSE
[01:19:20.884]      // skip if-block "continueId == 4"
[01:19:20.884]    </control>
[01:19:20.884]    <control if="!isProduction" while="" timeout="0" info="">
[01:19:20.884]      // if-block "!isProduction"
[01:19:20.884]        // =>  FALSE
[01:19:20.884]      // skip if-block "!isProduction"
[01:19:20.884]    </control>
[01:19:20.884]  </sequence>
