[01:33:56.048]        // -> [manuf <= 0x00000000]
[01:33:56.048]      __var isMSPM0G1X0X_G3X0X = 0;
[01:33:56.048]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[01:33:56.048]      __var isProduction = 0;
[01:33:56.048]        // -> [isProduction <= 0x00000000]
[01:33:56.048]      __var continueId = 0;
[01:33:56.048]        // -> [continueId <= 0x00000000]
[01:33:56.048]      deviceID =   Read32(0x41C40004);
[01:33:56.055]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[01:33:56.055]        // -> [deviceID <= 0x2BB8802F]
[01:33:56.055]      version = deviceID >> 28;
[01:33:56.055]        // -> [version <= 0x00000002]
[01:33:56.055]      partNum = (deviceID & 0x0FFFF000) >> 12;
[01:33:56.055]        // -> [partNum <= 0x0000BB88]
[01:33:56.055]      manuf = (deviceID & 0x00000FFE) >> 1;
[01:33:56.055]        // -> [manuf <= 0x00000017]
[01:33:56.055]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
