[02:06:09.423]      __var deviceID = 0;
[02:06:09.423]        // -> [deviceID <= 0x00000000]
[02:06:09.423]      __var version = 0;
[02:06:09.423]        // -> [version <= 0x00000000]
[02:06:09.423]      __var partNum = 0;
[02:06:09.423]        // -> [partNum <= 0x00000000]
[02:06:09.423]      __var manuf = 0;
[02:06:09.423]        // -> [manuf <= 0x00000000]
[02:06:09.423]      __var isMSPM0G1X0X_G3X0X = 0;
[02:06:09.423]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[02:06:09.423]      __var isProduction = 0;
[02:06:09.423]        // -> [isProduction <= 0x00000000]
[02:06:09.423]      __var continueId = 0;
[02:06:09.423]        // -> [continueId <= 0x00000000]
[02:06:09.424]      deviceID =   Read32(0x41C40004);
[02:06:09.428]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[02:06:09.429]        // -> [deviceID <= 0x2BB8802F]
[02:06:09.429]      version = deviceID >> 28;
[02:06:09.429]        // -> [version <= 0x00000002]
[02:06:09.429]      partNum = (deviceID & 0x0FFFF000) >> 12;
[02:06:09.429]        // -> [partNum <= 0x0000BB88]
[02:06:09.429]      manuf = (deviceID & 0x00000FFE) >> 1;
[02:06:09.429]        // -> [manuf <= 0x00000017]
[02:06:09.429]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[02:06:09.429]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[02:06:09.429]      isProduction = (version > 0);
[02:06:09.429]        // -> [isProduction <= 0x00000001]
[02:06:09.429]    </block>
[02:06:09.429]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
