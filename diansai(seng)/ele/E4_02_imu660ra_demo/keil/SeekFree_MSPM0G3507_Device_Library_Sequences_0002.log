[02:06:45.512]      __var DP_CTRL_STAT      = 0x4;
[02:06:45.512]        // -> [DP_CTRL_STAT <= 0x00000004]
[02:06:45.512]      __var DP_SELECT         = 0x8;
[02:06:45.513]        // -> [DP_SELECT <= 0x00000008]
[02:06:45.513]      __var powered_down      = 0;
[02:06:45.513]        // -> [powered_down <= 0x00000000]
[02:06:45.513]      WriteDP(DP_SELECT, 0x00000000);
[02:06:45.515]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[02:06:45.515]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[02:06:45.517]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[02:06:45.517]        // -> [powered_down <= 0x00000001]
