[00:24:11.360]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[00:24:11.360]    <block atomic="false" info="">
[00:24:11.360]      __var deviceID = 0;
[00:24:11.360]        // -> [deviceID <= 0x00000000]
[00:24:11.360]      __var version = 0;
[00:24:11.360]        // -> [version <= 0x00000000]
[00:24:11.360]      __var partNum = 0;
[00:24:11.360]        // -> [partNum <= 0x00000000]
[00:24:11.360]      __var manuf = 0;
[00:24:11.360]        // -> [manuf <= 0x00000000]
[00:24:11.360]      __var isMSPM0G1X0X_G3X0X = 0;
[00:24:11.360]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[00:24:11.360]      __var isProduction = 0;
[00:24:11.360]        // -> [isProduction <= 0x00000000]
[00:24:11.361]      __var continueId = 0;
[00:24:11.361]        // -> [continueId <= 0x00000000]
[00:24:11.361]      deviceID =   Read32(0x41C40004);
[00:24:11.366]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[00:24:11.366]        // -> [deviceID <= 0x2BB8802F]
[00:24:11.366]      version = deviceID >> 28;
[00:24:11.366]        // -> [version <= 0x00000002]
[00:24:11.366]      partNum = (deviceID & 0x0FFFF000) >> 12;
[00:24:11.366]        // -> [partNum <= 0x0000BB88]
[00:24:11.366]      manuf = (deviceID & 0x00000FFE) >> 1;
[00:24:11.366]        // -> [manuf <= 0x00000017]
[00:24:11.366]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[00:24:11.366]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[00:24:11.366]      isProduction = (version > 0);
[00:24:11.366]        // -> [isProduction <= 0x00000001]
[00:24:11.366]    </block>
[00:24:11.368]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[00:24:11.368]      // if-block "!isMSPM0G1X0X_G3X0X"
[00:24:11.368]        // =>  FALSE
