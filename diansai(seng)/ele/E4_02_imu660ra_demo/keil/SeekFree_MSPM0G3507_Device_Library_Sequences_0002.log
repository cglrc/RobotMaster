[00:24:43.730]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:24:43.731]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
