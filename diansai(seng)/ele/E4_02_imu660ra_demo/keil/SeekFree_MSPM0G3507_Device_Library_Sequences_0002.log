[01:19:57.951]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[01:19:57.951]    <block atomic="false" info="">
[01:19:57.951]      __var SW_DP_ABORT       = 0x0;
[01:19:57.951]        // -> [SW_DP_ABORT <= 0x00000000]
[01:19:57.951]      __var DP_CTRL_STAT      = 0x4;
[01:19:57.951]        // -> [DP_CTRL_STAT <= 0x00000004]
[01:19:57.951]      __var DP_SELECT         = 0x8;
[01:19:57.951]        // -> [DP_SELECT <= 0x00000008]
[01:19:57.951]      __var powered_down      = 0;
[01:19:57.951]        // -> [powered_down <= 0x00000000]
[01:19:57.951]      WriteDP(DP_SELECT, 0x00000000);
[01:19:57.953]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[01:19:57.953]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[01:19:57.955]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[01:19:57.955]        // -> [powered_down <= 0x00000001]
[01:19:57.955]    </block>
[01:19:57.955]    <control if="powered_down" while="" timeout="0" info="">
[01:19:57.955]      // if-block "powered_down"
[01:19:57.955]        // =>  TRUE
[01:19:57.955]      <block atomic="false" info="">
[01:19:57.955]        Message(0, "Debug/System power-up request sent");
[01:19:57.958]        WriteDP(DP_CTRL_STAT, 0x50000000);
[01:19:57.960]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[01:19:57.961]      </block>
[01:19:57.961]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[01:19:57.961]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[01:19:57.962]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[01:19:57.962]        // while-condition  =>  FALSE
[01:19:57.963]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[01:19:57.963]      </control>
[01:19:57.963]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[01:19:57.963]        // if-block "(__protocol & 0xFFFF) == 1"
[01:19:57.963]          // =>  FALSE
[01:19:57.963]        // skip if-block "(__protocol & 0xFFFF) == 1"
[01:19:57.963]      </control>
[01:19:57.963]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[01:19:57.963]        // if-block "(__protocol & 0xFFFF) == 2"
[01:19:57.963]          // =>  TRUE
[01:19:57.963]        <block atomic="false" info="">
[01:19:57.964]          Message(0, "executing SWD power up");
[01:19:57.966]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[01:19:57.967]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[01:19:57.967]          WriteDP(SW_DP_ABORT, 0x0000001E);
[01:19:57.970]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[01:19:57.970]        </block>
[01:19:57.970]        // end if-block "(__protocol & 0xFFFF) == 2"
[01:19:57.970]      </control>
[01:19:57.970]      // end if-block "powered_down"
[01:19:57.970]    </control>
[01:19:57.970]    <block atomic="false" info="">
[01:19:57.970]      __var DEBUG_PORT_VAL    = 0;
[01:19:57.970]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[01:19:57.970]      __var ACCESS_POINT_VAL  = 0;
[01:19:57.970]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[01:19:57.970]      __ap = 1; 
[01:19:57.970]        // -> [__ap <= 0x00000001]
[01:19:57.971]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[01:19:57.974]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[01:19:57.974]      __ap = 4;
[01:19:57.974]        // -> [__ap <= 0x00000004]
[01:19:57.974]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[01:19:57.978]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[01:19:57.979]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[01:19:57.979]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[01:19:57.981]    </block>
[01:19:57.981]    <block atomic="false" info="">
[01:19:57.981]      __var nReset = 0x80;
