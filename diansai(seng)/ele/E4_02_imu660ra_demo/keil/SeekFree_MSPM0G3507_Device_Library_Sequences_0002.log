[02:06:45.490]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[02:06:45.490]    <block atomic="false" info="">
[02:06:45.490]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[02:06:45.490]        // -> [isSWJ <= 0x00000001]
[02:06:45.490]      __var hasDormant = __protocol & 0x00020000;
[02:06:45.490]        // -> [hasDormant <= 0x00000000]
[02:06:45.490]      __var protType   = __protocol & 0x0000FFFF;
[02:06:45.490]        // -> [protType <= 0x00000002]
[02:06:45.490]    </block>
[02:06:45.491]    <control if="protType == 1" while="" timeout="0" info="">
[02:06:45.491]      // if-block "protType == 1"
[02:06:45.491]        // =>  FALSE
[02:06:45.491]      // skip if-block "protType == 1"
[02:06:45.491]    </control>
[02:06:45.491]    <control if="protType == 2" while="" timeout="0" info="">
[02:06:45.491]      // if-block "protType == 2"
[02:06:45.491]        // =>  TRUE
[02:06:45.491]      <control if="isSWJ" while="" timeout="0" info="">
[02:06:45.491]        // if-block "isSWJ"
[02:06:45.491]          // =>  TRUE
[02:06:45.491]        <control if="hasDormant" while="" timeout="0" info="">
[02:06:45.491]          // if-block "hasDormant"
[02:06:45.492]            // =>  FALSE
[02:06:45.492]          // skip if-block "hasDormant"
[02:06:45.492]        </control>
[02:06:45.492]        <control if="!hasDormant" while="" timeout="0" info="">
[02:06:45.492]          // if-block "!hasDormant"
[02:06:45.492]            // =>  TRUE
[02:06:45.492]          <block atomic="false" info="">
[02:06:45.492]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[02:06:45.493]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:06:45.494]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[02:06:45.495]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[02:06:45.495]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[02:06:45.497]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:06:45.497]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[02:06:45.499]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[02:06:45.499]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[02:06:45.501]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:06:45.501]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[02:06:45.504]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[02:06:45.504]          </block>
[02:06:45.504]          // end if-block "!hasDormant"
[02:06:45.504]        </control>
[02:06:45.504]        // end if-block "isSWJ"
[02:06:45.504]      </control>
[02:06:45.504]      <control if="!isSWJ" while="" timeout="0" info="">
[02:06:45.504]        // if-block "!isSWJ"
[02:06:45.504]          // =>  FALSE
[02:06:45.504]        // skip if-block "!isSWJ"
[02:06:45.504]      </control>
[02:06:45.504]      <block atomic="false" info="">
[02:06:45.504]        ReadDP(0x0);
[02:06:45.506]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[02:06:45.506]      </block>
[02:06:45.506]      // end if-block "protType == 2"
[02:06:45.506]    </control>
[02:06:45.507]  </sequence>
