[01:19:57.950]  **********  Sequence "DebugPortStart"  (Context="Connect", Pname="", info="")
[01:19:57.950]  
[01:19:57.950]  <debugvars>
[01:19:57.950]    // Pre-defined
[01:19:57.950]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[01:19:57.950]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[01:19:57.950]    __dp=0x00000000
[01:19:57.950]    __ap=0x00000000
