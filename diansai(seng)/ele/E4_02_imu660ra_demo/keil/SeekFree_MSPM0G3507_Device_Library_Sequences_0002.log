[01:33:55.985]        // if-block "(__protocol & 0xFFFF) == 2"
[01:33:55.985]          // =>  TRUE
[01:33:55.985]        <block atomic="false" info="">
[01:33:55.985]          Message(0, "executing SWD power up");
[01:33:55.987]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[01:33:55.989]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[01:33:55.989]          WriteDP(SW_DP_ABORT, 0x0000001E);
[01:33:55.991]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[01:33:55.991]        </block>
[01:33:55.991]        // end if-block "(__protocol & 0xFFFF) == 2"
[01:33:55.991]      </control>
[01:33:55.991]      // end if-block "powered_down"
