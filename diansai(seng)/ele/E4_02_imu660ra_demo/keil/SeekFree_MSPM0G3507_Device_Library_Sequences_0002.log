[01:33:55.974]        // -> [powered_down <= 0x00000000]
[01:33:55.974]      WriteDP(DP_SELECT, 0x00000000);
[01:33:55.975]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[01:33:55.975]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
