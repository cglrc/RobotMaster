[01:34:53.678]        // -> [deviceID <= 0x2BB8802F]
[01:34:53.678]      version = deviceID >> 28;
[01:34:53.678]        // -> [version <= 0x00000002]
[01:34:53.678]      partNum = (deviceID & 0x0FFFF000) >> 12;
[01:34:53.678]        // -> [partNum <= 0x0000BB88]
[01:34:53.678]      manuf = (deviceID & 0x00000FFE) >> 1;
[01:34:53.678]        // -> [manuf <= 0x00000017]
[01:34:53.678]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[01:34:53.678]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[01:34:53.678]      isProduction = (version > 0);
[01:34:53.679]        // -> [isProduction <= 0x00000001]
[01:34:53.679]    </block>
