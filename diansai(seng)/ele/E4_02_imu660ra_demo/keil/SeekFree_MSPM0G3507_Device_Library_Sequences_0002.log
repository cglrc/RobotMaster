[01:19:57.928]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[01:19:57.928]    <block atomic="false" info="">
[01:19:57.928]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[01:19:57.928]        // -> [isSWJ <= 0x00000001]
[01:19:57.928]      __var hasDormant = __protocol & 0x00020000;
[01:19:57.928]        // -> [hasDormant <= 0x00000000]
[01:19:57.929]      __var protType   = __protocol & 0x0000FFFF;
[01:19:57.929]        // -> [protType <= 0x00000002]
[01:19:57.929]    </block>
[01:19:57.929]    <control if="protType == 1" while="" timeout="0" info="">
[01:19:57.929]      // if-block "protType == 1"
[01:19:57.929]        // =>  FALSE
[01:19:57.929]      // skip if-block "protType == 1"
[01:19:57.929]    </control>
[01:19:57.929]    <control if="protType == 2" while="" timeout="0" info="">
[01:19:57.929]      // if-block "protType == 2"
[01:19:57.929]        // =>  TRUE
[01:19:57.929]      <control if="isSWJ" while="" timeout="0" info="">
[01:19:57.930]        // if-block "isSWJ"
[01:19:57.930]          // =>  TRUE
[01:19:57.930]        <control if="hasDormant" while="" timeout="0" info="">
[01:19:57.930]          // if-block "hasDormant"
[01:19:57.930]            // =>  FALSE
[01:19:57.930]          // skip if-block "hasDormant"
[01:19:57.930]        </control>
[01:19:57.930]        <control if="!hasDormant" while="" timeout="0" info="">
[01:19:57.930]          // if-block "!hasDormant"
[01:19:57.930]            // =>  TRUE
[01:19:57.930]          <block atomic="false" info="">
[01:19:57.930]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[01:19:57.932]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[01:19:57.932]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[01:19:57.934]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[01:19:57.935]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[01:19:57.936]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[01:19:57.936]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[01:19:57.938]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[01:19:57.938]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[01:19:57.940]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[01:19:57.940]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[01:19:57.942]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[01:19:57.942]          </block>
[01:19:57.942]          // end if-block "!hasDormant"
[01:19:57.942]        </control>
[01:19:57.942]        // end if-block "isSWJ"
[01:19:57.942]      </control>
[01:19:57.942]      <control if="!isSWJ" while="" timeout="0" info="">
[01:19:57.942]        // if-block "!isSWJ"
[01:19:57.942]          // =>  FALSE
[01:19:57.943]        // skip if-block "!isSWJ"
[01:19:57.943]      </control>
[01:19:57.943]      <block atomic="false" info="">
[01:19:57.943]        ReadDP(0x0);
[01:19:57.946]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[01:19:57.946]      </block>
[01:19:57.946]      // end if-block "protType == 2"
[01:19:57.946]    </control>
[01:19:57.946]  </sequence>
