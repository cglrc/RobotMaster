[01:06:33.298]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[01:06:33.298]      __var isProduction = 0;
[01:06:33.298]        // -> [isProduction <= 0x00000000]
[01:06:33.298]      __var continueId = 0;
[01:06:33.298]        // -> [continueId <= 0x00000000]
[01:06:33.299]      deviceID =   Read32(0x41C40004);
[01:06:33.305]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[01:06:33.305]        // -> [deviceID <= 0x2BB8802F]
[01:06:33.305]      version = deviceID >> 28;
[01:06:33.305]        // -> [version <= 0x00000002]
[01:06:33.305]      partNum = (deviceID & 0x0FFFF000) >> 12;
[01:06:33.305]        // -> [partNum <= 0x0000BB88]
[01:06:33.305]      manuf = (deviceID & 0x00000FFE) >> 1;
[01:06:33.305]        // -> [manuf <= 0x00000017]
[01:06:33.305]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[01:06:33.305]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[01:06:33.305]      isProduction = (version > 0);
[01:06:33.305]        // -> [isProduction <= 0x00000001]
