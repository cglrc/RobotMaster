[01:33:55.996]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[01:33:55.996]      __ap = 4;
[01:33:55.996]        // -> [__ap <= 0x00000004]
