[02:06:45.524]          // =>  TRUE
[02:06:45.524]        <block atomic="false" info="">
[02:06:45.524]          Message(0, "executing SWD power up");
[02:06:45.525]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[02:06:45.527]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[02:06:45.527]          WriteDP(SW_DP_ABORT, 0x0000001E);
[02:06:45.529]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[02:06:45.529]        </block>
[02:06:45.529]        // end if-block "(__protocol & 0xFFFF) == 2"
[02:06:45.529]      </control>
[02:06:45.529]      // end if-block "powered_down"
[02:06:45.529]    </control>
[02:06:45.529]    <block atomic="false" info="">
