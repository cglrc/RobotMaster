[02:06:45.530]        // -> [__ap <= 0x00000001]
[02:06:45.530]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[02:06:45.534]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[02:06:45.534]      __ap = 4;
[02:06:45.534]        // -> [__ap <= 0x00000004]
