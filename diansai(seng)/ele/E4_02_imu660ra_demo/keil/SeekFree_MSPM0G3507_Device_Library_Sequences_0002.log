[01:19:57.927]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[01:19:57.927]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[01:19:57.927]    __dp=0x00000000
