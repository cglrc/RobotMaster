[00:15:37.582]            // =>  TRUE
[00:15:37.582]          <block atomic="false" info="">
[00:15:37.582]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:15:37.584]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
