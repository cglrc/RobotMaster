[00:20:13.719]        // -> [partNum <= 0x00000000]
[00:20:13.719]      __var manuf = 0;
[00:20:13.719]        // -> [manuf <= 0x00000000]
[00:20:13.719]      __var isMSPM0G1X0X_G3X0X = 0;
[00:20:13.719]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[00:20:13.719]      __var isProduction = 0;
[00:20:13.719]        // -> [isProduction <= 0x00000000]
[00:20:13.720]      __var continueId = 0;
[00:20:13.720]        // -> [continueId <= 0x00000000]
[00:20:13.720]      deviceID =   Read32(0x41C40004);
[00:20:13.725]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[00:20:13.725]        // -> [deviceID <= 0x2BB8802F]
[00:20:13.725]      version = deviceID >> 28;
[00:20:13.725]        // -> [version <= 0x00000002]
[00:20:13.725]      partNum = (deviceID & 0x0FFFF000) >> 12;
[00:20:13.725]        // -> [partNum <= 0x0000BB88]
[00:20:13.725]      manuf = (deviceID & 0x00000FFE) >> 1;
[00:20:13.726]        // -> [manuf <= 0x00000017]
[00:20:13.726]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[00:20:13.726]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[00:20:13.726]      isProduction = (version > 0);
[00:20:13.726]        // -> [isProduction <= 0x00000001]
[00:20:13.726]    </block>
[00:20:13.726]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
