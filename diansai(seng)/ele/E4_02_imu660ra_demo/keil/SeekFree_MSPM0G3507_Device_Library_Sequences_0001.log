[00:21:01.954]          <block atomic="false" info="">
[00:21:01.954]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:21:01.956]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
