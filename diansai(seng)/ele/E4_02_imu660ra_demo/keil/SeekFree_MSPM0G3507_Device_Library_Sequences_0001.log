[23:59:52.888]          <block atomic="false" info="">
[23:59:52.888]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[23:59:52.890]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
