[00:19:37.042]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[00:19:37.042]    <block atomic="false" info="">
[00:19:37.042]      __var SW_DP_ABORT       = 0x0;
[00:19:37.042]        // -> [SW_DP_ABORT <= 0x00000000]
[00:19:37.042]      __var DP_CTRL_STAT      = 0x4;
[00:19:37.043]        // -> [DP_CTRL_STAT <= 0x00000004]
[00:19:37.043]      __var DP_SELECT         = 0x8;
[00:19:37.043]        // -> [DP_SELECT <= 0x00000008]
[00:19:37.043]      __var powered_down      = 0;
[00:19:37.043]        // -> [powered_down <= 0x00000000]
[00:19:37.043]      WriteDP(DP_SELECT, 0x00000000);
[00:19:37.044]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[00:19:37.044]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[00:19:37.047]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[00:19:37.047]        // -> [powered_down <= 0x00000001]
[00:19:37.047]    </block>
[00:19:37.047]    <control if="powered_down" while="" timeout="0" info="">
[00:19:37.047]      // if-block "powered_down"
[00:19:37.047]        // =>  TRUE
[00:19:37.047]      <block atomic="false" info="">
[00:19:37.047]        Message(0, "Debug/System power-up request sent");
[00:19:37.049]        WriteDP(DP_CTRL_STAT, 0x50000000);
[00:19:37.050]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[00:19:37.050]      </block>
[00:19:37.050]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[00:19:37.051]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[00:19:37.053]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[00:19:37.053]        // while-condition  =>  FALSE
[00:19:37.053]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[00:19:37.053]      </control>
[00:19:37.053]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[00:19:37.053]        // if-block "(__protocol & 0xFFFF) == 1"
[00:19:37.054]          // =>  FALSE
[00:19:37.054]        // skip if-block "(__protocol & 0xFFFF) == 1"
[00:19:37.054]      </control>
[00:19:37.054]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[00:19:37.054]        // if-block "(__protocol & 0xFFFF) == 2"
[00:19:37.054]          // =>  TRUE
[00:19:37.054]        <block atomic="false" info="">
[00:19:37.054]          Message(0, "executing SWD power up");
[00:19:37.055]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[00:19:37.057]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[00:19:37.058]          WriteDP(SW_DP_ABORT, 0x0000001E);
[00:19:37.059]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[00:19:37.059]        </block>
[00:19:37.059]        // end if-block "(__protocol & 0xFFFF) == 2"
[00:19:37.060]      </control>
[00:19:37.060]      // end if-block "powered_down"
[00:19:37.060]    </control>
[00:19:37.060]    <block atomic="false" info="">
[00:19:37.060]      __var DEBUG_PORT_VAL    = 0;
[00:19:37.060]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[00:19:37.060]      __var ACCESS_POINT_VAL  = 0;
[00:19:37.060]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[00:19:37.060]      __ap = 1; 
[00:19:37.060]        // -> [__ap <= 0x00000001]
[00:19:37.060]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[00:19:37.064]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[00:19:37.064]      __ap = 4;
[00:19:37.064]        // -> [__ap <= 0x00000004]
[00:19:37.064]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[00:19:37.069]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[00:19:37.069]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[00:19:37.069]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[00:19:37.070]    </block>
