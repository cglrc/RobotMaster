[00:13:34.046]            // =>  TRUE
[00:13:34.046]          <block atomic="false" info="">
[00:13:34.047]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:13:34.048]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
