[00:19:44.693]      // if-block "protType == 2"
[00:19:44.693]        // =>  TRUE
[00:19:44.694]      <control if="isSWJ" while="" timeout="0" info="">
[00:19:44.694]        // if-block "isSWJ"
[00:19:44.694]          // =>  TRUE
[00:19:44.694]        <control if="hasDormant" while="" timeout="0" info="">
[00:19:44.694]          // if-block "hasDormant"
[00:19:44.694]            // =>  FALSE
[00:19:44.694]          // skip if-block "hasDormant"
[00:19:44.694]        </control>
[00:19:44.694]        <control if="!hasDormant" while="" timeout="0" info="">
[00:19:44.694]          // if-block "!hasDormant"
[00:19:44.694]            // =>  TRUE
[00:19:44.694]          <block atomic="false" info="">
[00:19:44.694]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:19:44.696]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:19:44.696]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[00:19:44.697]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[00:19:44.698]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[00:19:44.699]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:19:44.699]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[00:19:44.701]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[00:19:44.701]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[00:19:44.704]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:19:44.704]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[00:19:44.705]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[00:19:44.706]          </block>
[00:19:44.706]          // end if-block "!hasDormant"
[00:19:44.706]        </control>
[00:19:44.706]        // end if-block "isSWJ"
[00:19:44.706]      </control>
