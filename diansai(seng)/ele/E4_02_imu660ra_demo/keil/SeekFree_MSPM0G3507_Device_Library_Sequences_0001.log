[00:20:13.622]            // =>  TRUE
[00:20:13.622]          <block atomic="false" info="">
[00:20:13.622]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
