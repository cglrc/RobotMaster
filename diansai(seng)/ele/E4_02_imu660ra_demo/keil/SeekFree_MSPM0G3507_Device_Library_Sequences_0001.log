[00:19:37.020]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[00:19:37.020]    <block atomic="false" info="">
[00:19:37.020]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[00:19:37.020]        // -> [isSWJ <= 0x00000001]
[00:19:37.020]      __var hasDormant = __protocol & 0x00020000;
[00:19:37.020]        // -> [hasDormant <= 0x00000000]
[00:19:37.020]      __var protType   = __protocol & 0x0000FFFF;
[00:19:37.020]        // -> [protType <= 0x00000002]
[00:19:37.020]    </block>
[00:19:37.020]    <control if="protType == 1" while="" timeout="0" info="">
[00:19:37.020]      // if-block "protType == 1"
[00:19:37.020]        // =>  FALSE
[00:19:37.020]      // skip if-block "protType == 1"
[00:19:37.021]    </control>
[00:19:37.021]    <control if="protType == 2" while="" timeout="0" info="">
[00:19:37.021]      // if-block "protType == 2"
[00:19:37.021]        // =>  TRUE
[00:19:37.021]      <control if="isSWJ" while="" timeout="0" info="">
[00:19:37.021]        // if-block "isSWJ"
[00:19:37.021]          // =>  TRUE
[00:19:37.021]        <control if="hasDormant" while="" timeout="0" info="">
[00:19:37.021]          // if-block "hasDormant"
[00:19:37.021]            // =>  FALSE
[00:19:37.021]          // skip if-block "hasDormant"
[00:19:37.021]        </control>
[00:19:37.022]        <control if="!hasDormant" while="" timeout="0" info="">
[00:19:37.022]          // if-block "!hasDormant"
[00:19:37.022]            // =>  TRUE
[00:19:37.022]          <block atomic="false" info="">
[00:19:37.022]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:19:37.023]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:19:37.023]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[00:19:37.025]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[00:19:37.025]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[00:19:37.028]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:19:37.028]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[00:19:37.029]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[00:19:37.030]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[00:19:37.031]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:19:37.031]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[00:19:37.033]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[00:19:37.033]          </block>
[00:19:37.033]          // end if-block "!hasDormant"
[00:19:37.033]        </control>
[00:19:37.033]        // end if-block "isSWJ"
[00:19:37.033]      </control>
[00:19:37.033]      <control if="!isSWJ" while="" timeout="0" info="">
[00:19:37.033]        // if-block "!isSWJ"
[00:19:37.033]          // =>  FALSE
[00:19:37.035]        // skip if-block "!isSWJ"
[00:19:37.035]      </control>
[00:19:37.035]      <block atomic="false" info="">
[00:19:37.035]        ReadDP(0x0);
[00:19:37.037]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[00:19:37.037]      </block>
[00:19:37.037]      // end if-block "protType == 2"
[00:19:37.037]    </control>
[00:19:37.037]  </sequence>
