[00:05:39.562]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[00:05:39.562]    <block atomic="false" info="">
[00:05:39.562]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[00:05:39.562]        // -> [isSWJ <= 0x00000001]
[00:05:39.562]      __var hasDormant = __protocol & 0x00020000;
[00:05:39.562]        // -> [hasDormant <= 0x00000000]
[00:05:39.562]      __var protType   = __protocol & 0x0000FFFF;
[00:05:39.562]        // -> [protType <= 0x00000002]
[00:05:39.562]    </block>
[00:05:39.562]    <control if="protType == 1" while="" timeout="0" info="">
[00:05:39.562]      // if-block "protType == 1"
[00:05:39.562]        // =>  FALSE
[00:05:39.562]      // skip if-block "protType == 1"
[00:05:39.562]    </control>
[00:05:39.562]    <control if="protType == 2" while="" timeout="0" info="">
[00:05:39.562]      // if-block "protType == 2"
[00:05:39.562]        // =>  TRUE
[00:05:39.562]      <control if="isSWJ" while="" timeout="0" info="">
[00:05:39.562]        // if-block "isSWJ"
[00:05:39.562]          // =>  TRUE
[00:05:39.563]        <control if="hasDormant" while="" timeout="0" info="">
[00:05:39.563]          // if-block "hasDormant"
[00:05:39.563]            // =>  FALSE
[00:05:39.563]          // skip if-block "hasDormant"
[00:05:39.563]        </control>
[00:05:39.563]        <control if="!hasDormant" while="" timeout="0" info="">
[00:05:39.563]          // if-block "!hasDormant"
[00:05:39.563]            // =>  TRUE
[00:05:39.563]          <block atomic="false" info="">
[00:05:39.563]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:05:39.565]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:05:39.565]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[00:05:39.567]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[00:05:39.567]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[00:05:39.569]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:05:39.569]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[00:05:39.571]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[00:05:39.571]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[00:05:39.573]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:05:39.574]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[00:05:39.575]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[00:05:39.575]          </block>
[00:05:39.575]          // end if-block "!hasDormant"
[00:05:39.575]        </control>
[00:05:39.576]        // end if-block "isSWJ"
[00:05:39.576]      </control>
[00:05:39.576]      <control if="!isSWJ" while="" timeout="0" info="">
[00:05:39.576]        // if-block "!isSWJ"
[00:05:39.576]          // =>  FALSE
[00:05:39.576]        // skip if-block "!isSWJ"
[00:05:39.576]      </control>
[00:05:39.576]      <block atomic="false" info="">
[00:05:39.576]        ReadDP(0x0);
[00:05:39.578]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[00:05:39.578]      </block>
[00:05:39.578]      // end if-block "protType == 2"
