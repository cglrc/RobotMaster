[00:20:13.719]    <block atomic="false" info="">
[00:20:13.719]      __var deviceID = 0;
[00:20:13.719]        // -> [deviceID <= 0x00000000]
[00:20:13.719]      __var version = 0;
[00:20:13.719]        // -> [version <= 0x00000000]
