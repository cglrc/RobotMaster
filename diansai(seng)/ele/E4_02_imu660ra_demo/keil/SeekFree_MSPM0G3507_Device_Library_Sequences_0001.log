[00:19:37.125]      __var manuf = 0;
[00:19:37.125]        // -> [manuf <= 0x00000000]
[00:19:37.125]      __var isMSPM0G1X0X_G3X0X = 0;
[00:19:37.125]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[00:19:37.125]      __var isProduction = 0;
[00:19:37.125]        // -> [isProduction <= 0x00000000]
[00:19:37.125]      __var continueId = 0;
[00:19:37.125]        // -> [continueId <= 0x00000000]
[00:19:37.125]      deviceID =   Read32(0x41C40004);
[00:19:37.131]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[00:19:37.131]        // -> [deviceID <= 0x2BB8802F]
[00:19:37.131]      version = deviceID >> 28;
