[00:05:39.594]      </control>
[00:05:39.595]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[00:05:39.595]        // if-block "(__protocol & 0xFFFF) == 2"
[00:05:39.595]          // =>  TRUE
[00:05:39.595]        <block atomic="false" info="">
[00:05:39.595]          Message(0, "executing SWD power up");
[00:05:39.597]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[00:05:39.599]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
