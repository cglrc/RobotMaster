[00:16:48.232]            // =>  TRUE
[00:16:48.232]          <block atomic="false" info="">
[00:16:48.232]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:16:48.233]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:16:48.234]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[00:16:48.235]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[00:16:48.236]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
