[00:19:37.131]        // -> [partNum <= 0x0000BB88]
[00:19:37.131]      manuf = (deviceID & 0x00000FFE) >> 1;
[00:19:37.131]        // -> [manuf <= 0x00000017]
[00:19:37.131]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[00:19:37.131]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[00:19:37.133]      isProduction = (version > 0);
