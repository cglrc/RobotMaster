[00:19:44.708]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[00:19:44.709]      </block>
[00:19:44.709]      // end if-block "protType == 2"
[00:19:44.709]    </control>
