[00:19:44.797]        // -> [partNum <= 0x00000000]
[00:19:44.798]      __var manuf = 0;
[00:19:44.798]        // -> [manuf <= 0x00000000]
[00:19:44.798]      __var isMSPM0G1X0X_G3X0X = 0;
[00:19:44.798]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[00:19:44.798]      __var isProduction = 0;
[00:19:44.798]        // -> [isProduction <= 0x00000000]
[00:19:44.798]      __var continueId = 0;
[00:19:44.798]        // -> [continueId <= 0x00000000]
[00:19:44.798]      deviceID =   Read32(0x41C40004);
[00:19:44.804]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[00:19:44.805]        // -> [deviceID <= 0x2BB8802F]
[00:19:44.805]      version = deviceID >> 28;
[00:19:44.805]        // -> [version <= 0x00000002]
[00:19:44.805]      partNum = (deviceID & 0x0FFFF000) >> 12;
[00:19:44.805]        // -> [partNum <= 0x0000BB88]
[00:19:44.805]      manuf = (deviceID & 0x00000FFE) >> 1;
[00:19:44.805]        // -> [manuf <= 0x00000017]
[00:19:44.805]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[00:19:44.805]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[00:19:44.805]      isProduction = (version > 0);
[00:19:44.805]        // -> [isProduction <= 0x00000001]
[00:19:44.806]    </block>
