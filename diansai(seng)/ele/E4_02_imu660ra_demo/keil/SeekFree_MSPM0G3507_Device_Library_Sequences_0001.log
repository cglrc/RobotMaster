[00:19:44.692]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[00:19:44.692]    <block atomic="false" info="">
[00:19:44.692]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[00:19:44.693]        // -> [isSWJ <= 0x00000001]
[00:19:44.693]      __var hasDormant = __protocol & 0x00020000;
