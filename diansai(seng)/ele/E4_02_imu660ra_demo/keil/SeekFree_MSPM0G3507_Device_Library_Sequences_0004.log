[17:51:56.703]  **********  Sequence "DebugPortStart"  (Context="Connect", Pname="", info="")
[17:51:56.703]  
[17:51:56.704]  <debugvars>
[17:51:56.704]    // Pre-defined
[17:51:56.704]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[17:51:56.704]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[17:51:56.704]    __dp=0x00000000
[17:51:56.704]    __ap=0x00000000
[17:51:56.704]    __traceout=0x00000000      (Trace Disabled)
