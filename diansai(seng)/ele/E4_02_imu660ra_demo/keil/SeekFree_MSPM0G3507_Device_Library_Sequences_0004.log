[17:35:28.762]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[17:35:28.762]    <block atomic="false" info="">
[17:35:28.762]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[17:35:28.762]        // -> [isSWJ <= 0x00000001]
