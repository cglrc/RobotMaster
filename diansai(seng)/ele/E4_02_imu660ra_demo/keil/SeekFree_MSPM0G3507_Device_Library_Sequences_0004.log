[17:51:56.681]  <debugvars>
[17:51:56.681]    // Pre-defined
[17:51:56.681]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[17:51:56.681]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
