[17:36:50.919]            // =>  TRUE
[17:36:50.919]          <block atomic="false" info="">
[17:36:50.919]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
