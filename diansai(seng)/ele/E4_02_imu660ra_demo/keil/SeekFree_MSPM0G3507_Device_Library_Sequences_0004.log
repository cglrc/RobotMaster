[17:36:50.918]          // if-block "hasDormant"
[17:36:50.918]            // =>  FALSE
[17:36:50.918]          // skip if-block "hasDormant"
[17:36:50.918]        </control>
[17:36:50.919]        <control if="!hasDormant" while="" timeout="0" info="">
