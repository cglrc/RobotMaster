[17:51:56.704]  
[17:51:56.704]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[17:51:56.705]    <block atomic="false" info="">
[17:51:56.705]      __var SW_DP_ABORT       = 0x0;
[17:51:56.705]        // -> [SW_DP_ABORT <= 0x00000000]
[17:51:56.705]      __var DP_CTRL_STAT      = 0x4;
[17:51:56.705]        // -> [DP_CTRL_STAT <= 0x00000004]
[17:51:56.705]      __var DP_SELECT         = 0x8;
[17:51:56.705]        // -> [DP_SELECT <= 0x00000008]
[17:51:56.705]      __var powered_down      = 0;
[17:51:56.705]        // -> [powered_down <= 0x00000000]
[17:51:56.705]      WriteDP(DP_SELECT, 0x00000000);
[17:51:56.707]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[17:51:56.707]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[17:51:56.709]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[17:51:56.709]        // -> [powered_down <= 0x00000001]
[17:51:56.709]    </block>
[17:51:56.709]    <control if="powered_down" while="" timeout="0" info="">
[17:51:56.709]      // if-block "powered_down"
[17:51:56.710]        // =>  TRUE
[17:51:56.710]      <block atomic="false" info="">
[17:51:56.710]        Message(0, "Debug/System power-up request sent");
[17:51:56.711]        WriteDP(DP_CTRL_STAT, 0x50000000);
[17:51:56.714]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[17:51:56.714]      </block>
[17:51:56.714]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[17:51:56.714]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[17:51:56.715]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[17:51:56.715]        // while-condition  =>  FALSE
[17:51:56.716]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[17:51:56.716]      </control>
[17:51:56.716]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[17:51:56.716]        // if-block "(__protocol & 0xFFFF) == 1"
[17:51:56.716]          // =>  FALSE
[17:51:56.716]        // skip if-block "(__protocol & 0xFFFF) == 1"
[17:51:56.716]      </control>
[17:51:56.716]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[17:51:56.716]        // if-block "(__protocol & 0xFFFF) == 2"
[17:51:56.716]          // =>  TRUE
[17:51:56.716]        <block atomic="false" info="">
[17:51:56.716]          Message(0, "executing SWD power up");
[17:51:56.717]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[17:51:56.719]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[17:51:56.719]          WriteDP(SW_DP_ABORT, 0x0000001E);
[17:51:56.722]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[17:51:56.722]        </block>
[17:51:56.722]        // end if-block "(__protocol & 0xFFFF) == 2"
[17:51:56.722]      </control>
[17:51:56.722]      // end if-block "powered_down"
[17:51:56.722]    </control>
[17:51:56.722]    <block atomic="false" info="">
[17:51:56.722]      __var DEBUG_PORT_VAL    = 0;
[17:51:56.722]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[17:51:56.722]      __var ACCESS_POINT_VAL  = 0;
[17:51:56.723]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[17:51:56.723]      __ap = 1; 
[17:51:56.723]        // -> [__ap <= 0x00000001]
[17:51:56.723]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[17:51:56.727]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
