[17:50:05.988]        // -> [partNum <= 0x00000000]
[17:50:05.988]      __var manuf = 0;
[17:50:05.988]        // -> [manuf <= 0x00000000]
[17:50:05.988]      __var isMSPM0G1X0X_G3X0X = 0;
[17:50:05.988]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[17:50:05.989]      __var isProduction = 0;
[17:50:05.989]        // -> [isProduction <= 0x00000000]
[17:50:05.989]      __var continueId = 0;
[17:50:05.989]        // -> [continueId <= 0x00000000]
[17:50:05.989]      deviceID =   Read32(0x41C40004);
[17:50:05.995]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[17:50:05.995]        // -> [deviceID <= 0x2BB8802F]
[17:50:05.995]      version = deviceID >> 28;
[17:50:05.995]        // -> [version <= 0x00000002]
[17:50:05.995]      partNum = (deviceID & 0x0FFFF000) >> 12;
[17:50:05.995]        // -> [partNum <= 0x0000BB88]
[17:50:05.995]      manuf = (deviceID & 0x00000FFE) >> 1;
[17:50:05.995]        // -> [manuf <= 0x00000017]
[17:50:05.995]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[17:50:05.995]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[17:50:05.995]      isProduction = (version > 0);
[17:50:05.995]        // -> [isProduction <= 0x00000001]
[17:50:05.996]    </block>
[17:50:05.996]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
