[17:51:56.682]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[17:51:56.682]    <block atomic="false" info="">
[17:51:56.682]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[17:51:56.682]        // -> [isSWJ <= 0x00000001]
[17:51:56.682]      __var hasDormant = __protocol & 0x00020000;
[17:51:56.682]        // -> [hasDormant <= 0x00000000]
[17:51:56.682]      __var protType   = __protocol & 0x0000FFFF;
[17:51:56.682]        // -> [protType <= 0x00000002]
[17:51:56.682]    </block>
[17:51:56.682]    <control if="protType == 1" while="" timeout="0" info="">
[17:51:56.682]      // if-block "protType == 1"
[17:51:56.682]        // =>  FALSE
[17:51:56.683]      // skip if-block "protType == 1"
[17:51:56.683]    </control>
[17:51:56.683]    <control if="protType == 2" while="" timeout="0" info="">
[17:51:56.683]      // if-block "protType == 2"
[17:51:56.683]        // =>  TRUE
[17:51:56.684]      <control if="isSWJ" while="" timeout="0" info="">
[17:51:56.684]        // if-block "isSWJ"
[17:51:56.684]          // =>  TRUE
[17:51:56.684]        <control if="hasDormant" while="" timeout="0" info="">
[17:51:56.684]          // if-block "hasDormant"
[17:51:56.684]            // =>  FALSE
[17:51:56.684]          // skip if-block "hasDormant"
[17:51:56.684]        </control>
[17:51:56.684]        <control if="!hasDormant" while="" timeout="0" info="">
[17:51:56.684]          // if-block "!hasDormant"
[17:51:56.684]            // =>  TRUE
[17:51:56.684]          <block atomic="false" info="">
[17:51:56.684]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:51:56.686]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:51:56.687]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[17:51:56.688]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[17:51:56.688]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[17:51:56.690]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:51:56.690]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[17:51:56.692]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[17:51:56.692]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[17:51:56.695]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:51:56.695]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[17:51:56.696]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[17:51:56.697]          </block>
[17:51:56.697]          // end if-block "!hasDormant"
[17:51:56.697]        </control>
[17:51:56.697]        // end if-block "isSWJ"
[17:51:56.697]      </control>
[17:51:56.697]      <control if="!isSWJ" while="" timeout="0" info="">
[17:51:56.697]        // if-block "!isSWJ"
[17:51:56.697]          // =>  FALSE
[17:51:56.697]        // skip if-block "!isSWJ"
[17:51:56.697]      </control>
[17:51:56.697]      <block atomic="false" info="">
[17:51:56.697]        ReadDP(0x0);
[17:51:56.699]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[17:51:56.700]      </block>
[17:51:56.700]      // end if-block "protType == 2"
[17:51:56.700]    </control>
[17:51:56.700]  </sequence>
