[17:35:28.773]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[17:35:28.775]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[17:35:28.775]          </block>
[17:35:28.775]          // end if-block "!hasDormant"
