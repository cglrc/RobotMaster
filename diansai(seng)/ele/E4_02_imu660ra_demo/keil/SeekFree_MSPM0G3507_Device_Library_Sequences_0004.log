[17:35:28.764]        </control>
[17:35:28.764]        <control if="!hasDormant" while="" timeout="0" info="">
[17:35:28.764]          // if-block "!hasDormant"
[17:35:28.764]            // =>  TRUE
[17:35:28.764]          <block atomic="false" info="">
[17:35:28.764]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:35:28.766]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:35:28.766]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[17:35:28.767]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[17:35:28.767]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[17:35:28.769]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:35:28.769]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
